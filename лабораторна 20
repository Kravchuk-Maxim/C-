class Square { 
public: 
Square(double side) { 
    this->side=side;
    this->area=(side*side);
};
void set_side(double side) {
if (side>=0) {
this->side=side;
this->area=(side*side);
} }
void PrintSquareAttributes() {
    cout<<" Square's side length: "<<this->side<<", Square's area: "<<this->area<<"\n";
}
private: 
double side; 
double area; 
};



class AdHocSquare {
public:
void set_side(double side) { 
this->side = side; 
};
double get_area() { 
return (this->side*this->side); 
};
private:
double side;
};



class LazySquare {
public:

void set_side(double side) { 
int OldSide=this->side; 
this->side = side; 
if (OldSide!=side) { 
this->side_changed=true; 
} };

double get_area() { 
if ( (this->side_changed)==true) {
cout<<"[C]"; this->side_changed=false; this->area=(this->side*this->side); return this->area; 
}
else 
{ cout<<"[R]"; return this->area; }
};

private:
double side;
double area;
bool side_changed;
};



