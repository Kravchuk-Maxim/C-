#include <iostream>
#include <ctime>
#include <cmath>
using namespace std;

void increment(int *num) {
*num++;
}
void increment(int *num, int num2) {
*num += num2;
}

//ЗАПУСК ПРОГРАМИ
int main(void){

int var = 0;

for(int i = 0;i<10; i++) {
if(i%2==0) { increment(&var); } else { increment(&var,i); }
}
cout << var;
}
